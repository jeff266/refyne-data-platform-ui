# Supabase - same project as app.refynedata.com (iidsiejbhdpzzmbotybw)
NEXT_PUBLIC_SUPABASE_URL=https://iidsiejbhdpzzmbotybw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=           # From Supabase dashboard -> Settings -> API -> service_role key
                                     # WARNING: never expose this client-side. Server routes only.

# Clerk - same app as app.refynedata.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=   # From Clerk dashboard
CLERK_SECRET_KEY=                    # From Clerk dashboard

# Add these same values to Vercel:
# vercel env add NEXT_PUBLIC_SUPABASE_URL
# vercel env add SUPABASE_SERVICE_ROLE_KEY
# vercel env add NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
# vercel env add CLERK_SECRET_KEY
